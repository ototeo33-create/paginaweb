# Archivos y carpetas a ignorar para un proyecto PHP en XAMPP

# Archivos de configuración sensibles
.env

# Archivos de base de datos y backups
*.sql
*.sqlite
*.db
!schema_export.sql

# Archivos temporales y de caché
*.log
*.tmp
*.cache

# Directorios de subida de archivos
/uploads/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos de entorno de desarrollo
.vscode/
.idea/

# Archivos de control de versiones de otros sistemas
.svn/
.hg/

# Otros
node_modules/

# Ignorar fotos de estudiantes
uploads/fotos/

# Caché de audio TTS (generado por Kokoro en el servidor)
tts_cache/

# Archivos binarios grandes del simulador (subir por SCP)
cursodealmacenamiento/*.pptx
cursodealmacenamiento/*.xlsx

# Archivos de Claude Code
.claude/
